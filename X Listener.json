    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a sentiment analysis expert. \nAnalyze the sentiment of social media posts and classify them as \"Positive\", \"Negative\", or \"Neutral\". \nRespond ONLY in valid JSON format, structured exactly like this: {\"sentiment\": \"Positive\"}\nDo not include explanations, text, or anything else.\n\nAnalyze the sentiment of this tweet: {{ $json.text }}\n\n",
        "options": {}
      },
