      "type": "@n8n/n8n-nodes-langchain.lmChatOpenRouter",
      "typeVersion": 1,
      "position": [
        -288,
        576
      ],
      "id": "2ca4aabc-5599-44a3-b7e0-9db97ff7d123",
      "name": "OpenRouter Chat Model"
    },
    {
      "parameters": {
        "jsCode": "// Function node set to: Run Once for Each Item\nconst item = $input.item;\n\nconst rawOutput = item.json.output || item.json.response || item.json.text || JSON.stringify(item.json || {});\nconst aiText = typeof rawOutput === 'string' ? rawOutput : JSON.stringify(rawOutput);\n\nfunction validSentiment(s) {\n  return typeof s === 'string' && [\"Positive\",\"Negative\",\"Neutral\"].includes(s.trim());\n}\n\nlet sentiment = null;\n\n// Try parse JSON inside aiText\ntry {\n  const jsonMatch = aiText.match(/\\{[\\s\\S]*\\}/);\n  if (jsonMatch) {\n    const parsed = JSON.parse(jsonMatch[0]);\n    sentiment = parsed?.message?.content?.sentiment || parsed?.sentiment || null;\n    if (validSentiment(sentiment)) sentiment = sentiment.trim();\n    else sentiment = null;\n  }\n} catch (e) { /* ignore */ }\n\n// Try to find the word directly\nif (!sentiment) {\n  const r = aiText.match(/\\b(Positive|Negative|Neutral)\\b/i);\n  if (r) sentiment = r[0].charAt(0).toUpperCase() + r[0].slice(1).toLowerCase();\n}\n\n// Final fallback heuristic\nif (!sentiment) {\n  const post = item.json.text || \"\";\n  const neg = /\\b(hate|terrible|worst|awful|angry|disappointed|sucks|scam|stupid|broke)\\b/i;\n  const pos = /\\b(love|great|amazing|awesome|happy|excellent|nice|enjoyed|fantastic|best)\\b/i;\n  if (neg.test(post) && !pos.test(post)) sentiment = \"Negative\";\n  else if (pos.test(post) && !neg.test(post)) sentiment = \"Positive\";\n  else sentiment = \"Neutral\";\n}\n\n// Return single normalized item for this tweet\nreturn {\n  json: {\n    ...item.json,\n    message: { content: { sentiment } }\n  }\n};\n"
      },
